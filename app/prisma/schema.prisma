generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Better Auth models — see https://www.better-auth.com/docs/concepts/database#core-schema
// Field names match the Better Auth defaults; do not rename without also configuring
// the adapter's `fields` mapping.
model User {
  id            String           @id
  name          String
  email         String           @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  // i18n preferences — written by user.setPreferences tRPC mutation.
  // Safe defaults: existing rows stay unaffected by the migration.
  language      String           @default("en")
  currency      String           @default("EUR")
  sessions      Session[]
  accounts      Account[]
  budget        Budget?
  expenses      Expense[]
  habits        Habit[]
  exercises     Exercise[]
  routines      Routine[]
  workouts      Workout[]

  @@map("user")
}

// One row per user: the user's monthly budget. Single row, updated in place.
// No history of changes — mid-cycle edits apply retroactively (PRODUCT.md).
model Budget {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyAmountCents Int
  anchorDay          Int
  updatedAt          DateTime @updatedAt

  @@map("budget")
}

// A ledger entry: a normal SPEND or a one-off ADJUSTMENT to the cycle's
// available pool (a top-up or a set-aside). The sign convention lives in the
// domain (`src/domain/entry.ts`): a spend and a set-aside store a positive
// `amountCents`, a top-up stores a negative one, so the available/monthly math
// just sums signed amounts.
enum EntryKind {
  SPEND
  ADJUSTMENT
}

// Many rows per user. `createdAt` is set at submission time and never edited
// (no backdating, so an entry never shuffles between cycles); `amountCents`
// and `note`, however, are editable in place via `expense.update`, and
// `updatedAt` records that edit. `amountCents` is positive for a spend and
// signed for an adjustment (validated at the tRPC edge). Deletes are hard
// deletes — the row is physically removed.
model Expense {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        EntryKind @default(SPEND)
  amountCents Int
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([userId, createdAt])
  @@map("expense")
}

// A named daily habit, scoped to a user. `color` is auto-assigned at creation
// from a curated dark-theme palette and stored immutably so the card color never
// flickers between loads. `schedule` is reserved for future per-weekday
// scheduling and is unused in MVP — every day is a target.
model Habit {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  icon        String
  color       String
  schedule    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  completions HabitCompletion[]

  @@index([userId, createdAt])
  @@map("habit")
}

// Records that a habit was done on a given local calendar day. `day` is stored
// as a plain date (`@db.Date`) rather than a timestamp so there is no timezone
// math on the server — the day is a label the client supplies and the server
// persists verbatim. The `@@unique([habitId, day])` constraint ensures at most
// one completion per habit per day, making toggling idempotent (upsert + delete
// are both safe regardless of how many times the user taps).
model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([habitId, day])
  @@map("habit_completion")
}

// ─── Workout Tracker ──────────────────────────────────────────────────────────

// Built-in exercises have userId = null (seeded via prisma/seed.ts). Custom
// exercises created by a user carry their userId. The @@unique([userId, name])
// constraint allows two different users to create exercises with the same name,
// while preventing one user from having two exercises with the same name. A
// built-in exercise's name is globally unique among built-ins (userId = null,
// enforced at the application level in seed.ts).
model Exercise {
  id               String            @id @default(cuid())
  userId           String?
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  muscleGroup      MuscleGroup
  equipment        Equipment
  createdAt        DateTime          @default(now())
  routineExercises RoutineExercise[]
  workoutExercises WorkoutExercise[]

  @@unique([userId, name])
  @@index([userId])
  @@map("exercise")
}

// A saved workout plan the user can start from. Contains an ordered list of
// exercises with target sets, reps, and rest time.
model Routine {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  exercises   RoutineExercise[]
  workouts    Workout[]

  @@index([userId, createdAt])
  @@map("routine")
}

// Ordered exercise entry in a routine template. Stores target parameters for
// guidance during logging. Deleting an exercise that is used in a routine is
// blocked by the Restrict onDelete.
model RoutineExercise {
  id          String   @id @default(cuid())
  routineId   String
  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  position    Int
  targetSets  Int
  targetReps  String
  restSeconds Int      @default(120)

  @@map("routine_exercise")
}

// A single workout session. `finishedAt = null` means the workout is in
// progress. At most one active workout per user (enforced at the application
// layer). If the source routine is deleted, routineId is set to null.
model Workout {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId  String?
  routine    Routine?          @relation(fields: [routineId], references: [id], onDelete: SetNull)
  name       String
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
  exercises  WorkoutExercise[]

  @@index([userId, startedAt])
  @@index([userId, finishedAt])
  @@map("workout")
}

// Ordered exercise entry in a live or completed workout. Stores the actual rest
// time used. Deleting an exercise that has been logged is blocked (Restrict).
model WorkoutExercise {
  id          String       @id @default(cuid())
  workoutId   String
  workout     Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  position    Int
  restSeconds Int          @default(120)
  sets        WorkoutSet[]

  @@map("workout_exercise")
}

// A single set logged during a workout. weightGrams is null for bodyweight
// exercises. completed + completedAt are set when the user checks off the set.
model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  weightGrams       Int?
  reps              Int?
  completed         Boolean         @default(false)
  completedAt       DateTime?

  @@map("workout_set")
}

enum MuscleGroup {
  CHEST
  BACK
  LEGS
  SHOULDERS
  ARMS
  CORE
}

enum Equipment {
  BARBELL
  DUMBBELL
  CABLE
  MACHINE
  BODYWEIGHT
}

// ─── End Workout Tracker ──────────────────────────────────────────────────────

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
